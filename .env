VITE_API_BASE_URL=https://llc-backend-laravel.onrender.com/api/v1

# Realtime is disabled because the backend broadcasts to "log" (no Reverb server).
# Set VITE_REVERB_ENABLED=true and point VITE_REVERB_* at a real server to enable.
VITE_REVERB_ENABLED=false

VITE_REVERB_APP_KEY=local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http